            </ul>
        </div>
    </section>

    <!-- MÓDULO INTERACTIVO: CALCULADORA WEB EN .NET -->
    <section class="card calculator-section">
        <h2>Módulo Interactivo: Calculadora Web (.NET)</h2>
        <p>Calculadora integrada conectada al backend en C# para procesar las operaciones en el servidor.</p>
        
        <div class="calculator-box">
            <form method="post">
                <div class="form-group">
                    <label>Número 1:</label>
                    <input type="number" step="any" asp-for="Numero1" required />
                </div>

                <div class="form-group">
                    <label>Número 2:</label>
                    <input type="number" step="any" asp-for="Numero2" required />
                </div>

                <div class="form-group">
                    <label>Operación:</label>
                    <select asp-for="Operacion">
                        <option value="sumar">Sumar (+)</option>
                        <option value="restar">Restar (-)</option>
                        <option value="multiplicar">Multiplicar (×)</option>
                        <option value="dividir">Dividir (÷)</option>
                    </select>
                </div>

                <button type="submit" class="calc-btn">Calcular en Servidor (.NET)</button>
            </form>

            @if (Model.Resultado != null)
            {
                <div class="calc-result success">
                    <strong>Resultado:</strong> <span>@Model.Resultado</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="calc-result error">
                    <strong>@Model.MensajeError</strong>
                </div>
            }
        </div>
    </section>
</main>

<footer>
