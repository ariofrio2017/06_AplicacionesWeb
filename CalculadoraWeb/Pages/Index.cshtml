    <!-- Educación y Certificaciones -->
    <section class="grid-2">
        <div class="card">
            <h2>Educación</h2>
            <div class="item">
                <h3>Estudiante Sexto Semestre Ingeniería en Software</h3>
                <p class="institution">UNIANDES</p>
            </div>
            <div class="item">
                <h3>Tecnólogo en Desarrollo de Software</h3>
                <p class="institution">Instituto Superior Tecnológico Espíritu Santo</p>
