@model EvaluacionParcial1.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Libro
    </h2>
    <p class="text-muted mb-0">
        Actualiza la información del libro y sus autores asociados.
    </p>
</div>
<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="LibroId" />

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Genero" class="form-label fw-semibold">Género</label>
                <input asp-for="Genero" class="form-control" />
                <span asp-validation-for="Genero" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AnioPublicacion" class="form-label fw-semibold">Año de publicación</label>
                <input asp-for="AnioPublicacion" class="form-control" type="number" />
                <span asp-validation-for="AnioPublicacion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label for="autoresSeleccionados" class="form-label fw-semibold">Autor(es)</label>
                <select id="autoresSeleccionados"
                        name="autoresSeleccionados"
                        asp-items="ViewBag.Autores"
                        class="form-select"
                        multiple
                        size="5"></select>
                <div class="form-text">
                    Selecciona uno o varios autores (mantén presionada la tecla <strong>Ctrl</strong> o <strong>Cmd</strong> para elegir más de uno).
                </div>
                <span class="text-danger small">@Html.ValidationMessage("autoresSeleccionados")</span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}