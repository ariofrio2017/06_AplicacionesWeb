@model IEnumerable<EvaluacionParcial1.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-journal-bookmark text-primary me-2"></i>Libros
        </h2>
        <p class="text-muted mb-0">
            Catálogo de libros y autores asociados.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Libro
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle border">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th class="text-center">Año de publicación</th>
                <th>Autores</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        <i class="bi bi-info-circle me-1"></i>No hay libros registrados todavía.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var autoresTexto = item.LibroAutores != null && item.LibroAutores.Any()
                    ? string.Join(", ", item.LibroAutores
                    .OrderBy(la => la.OrdenAutoria)
                    .Select(la => la.Autor != null ? $"{la.Autor.Nombre} {la.Autor.Apellido}" : $"Autor #{la.AutorId}"))
                    : "Sin autor asignado";

                    <tr>
                        <td class="fw-semibold">@item.Titulo</td>
                        <td>@item.Genero</td>
                        <td class="text-center">@item.AnioPublicacion</td>
                        <td>@autoresTexto</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.LibroId" class="btn btn-sm btn-outline-warning text-dark">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.LibroId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btn-eliminar-libro"
                                    data-bs-toggle="modal"
                                    data-bs-target="#confirmarEliminarModal"
                                    data-libro-id="@item.LibroId"
                                    data-libro-titulo="@item.Titulo">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Modal de confirmación Bootstrap -->
<div class="modal fade" id="confirmarEliminarModal" tabindex="-1" aria-labelledby="confirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="confirmarEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0">
                    ¿Estás seguro de que deseas eliminar el libro <strong id="libroTituloModal"></strong>?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </button>
                <form id="formEliminarLibro" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-lg me-1"></i>Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("confirmarEliminarModal");
            const formEliminar = document.getElementById("formEliminarLibro");
            const tituloSpan = document.getElementById("libroTituloModal");

            modalEl.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                const libroId = button.getAttribute("data-libro-id");
                const libroTitulo = button.getAttribute("data-libro-titulo");

                tituloSpan.textContent = libroTitulo;
                formEliminar.setAttribute("action", `/Libros/Delete/${libroId}`);
            });
        });
    </script>
}