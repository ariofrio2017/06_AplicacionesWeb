@model EvaluacionParcial1.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
    var autoresOrdenados = Model.LibroAutores?
        .OrderBy(la => la.OrdenAutoria)
        .Select(la => la.Autor != null ? $"{la.Autor.Nombre} {la.Autor.Apellido}" : $"Autor #{la.AutorId}")
        .ToList() ?? new List<string>();
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-eye text-info me-2"></i>Detalles del Libro
    </h2>
    <p class="text-muted mb-0">
        Información completa del registro seleccionado.
    </p>
</div>
<hr />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Título</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Titulo</dd>

            <dt class="col-sm-3 text-muted">Género</dt>
            <dd class="col-sm-9">@Model.Genero</dd>

            <dt class="col-sm-3 text-muted">Año de publicación</dt>
            <dd class="col-sm-9">@Model.AnioPublicacion</dd>

            <dt class="col-sm-3 text-muted">Autor(es)</dt>
            <dd class="col-sm-9">
                @if (autoresOrdenados.Any())
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var autor in autoresOrdenados)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis border px-2 py-1">@autor</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">Sin autor asignado</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-warning text-dark">
        <i class="bi bi-pencil me-1"></i>Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista
    </a>
</div>