@model EvaluacionParcial1.Models.Prestamo

@{
    ViewData["Title"] = "Detalles del Préstamo";

    var tituloLibro = Model.Libro?.Titulo ?? $"Libro #{Model.LibroId}";
    var nombreMiembro = Model.Miembro != null
        ? $"{Model.Miembro.Nombre} {Model.Miembro.Apellido}"
        : $"Miembro #{Model.MiembroId}";

    var badgeEstado = Model.Estado switch
    {
        "Activo" => "bg-primary-subtle text-primary-emphasis border",
        "Devuelto" => "bg-success-subtle text-success-emphasis border",
        "Vencido" => "bg-danger-subtle text-danger-emphasis border",
        _ => "bg-secondary-subtle text-secondary-emphasis border"
    };
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-eye text-info me-2"></i>Detalles del Préstamo
    </h2>
    <p class="text-muted mb-0">
        Información completa del préstamo registrado.
    </p>
</div>
<hr />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Libro</dt>
            <dd class="col-sm-9 fw-semibold">@tituloLibro</dd>

            <dt class="col-sm-3 text-muted">Miembro</dt>
            <dd class="col-sm-9 fw-semibold">@nombreMiembro</dd>

            <dt class="col-sm-3 text-muted">Fecha de préstamo</dt>
            <dd class="col-sm-9">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 text-muted">Fecha de devolución</dt>
            <dd class="col-sm-9">
                @(Model.FechaDevolucion.HasValue
                                ? Model.FechaDevolucion.Value.ToString("dd/MM/yyyy")
                                : "Pendiente")
            </dd>

            <dt class="col-sm-3 text-muted">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @badgeEstado px-3 py-1">@Model.Estado</span>
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.PrestamoId" class="btn btn-warning text-dark">
        <i class="bi bi-pencil me-1"></i>Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista
    </a>
</div>