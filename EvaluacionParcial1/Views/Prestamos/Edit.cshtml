@model EvaluacionParcial1.Models.Prestamo

@{
    ViewData["Title"] = "Editar Préstamo";
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Préstamo
    </h2>
    <p class="text-muted mb-0">
        Actualiza el libro, el miembro, las fechas o el estado del préstamo.
    </p>
</div>
<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="PrestamoId" />

            <div class="mb-3">
                <label asp-for="LibroId" class="form-label fw-semibold">Libro</label>
                <select asp-for="LibroId" asp-items="ViewBag.LibroId" class="form-select"></select>
                <span asp-validation-for="LibroId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MiembroId" class="form-label fw-semibold">Miembro</label>
                <select asp-for="MiembroId" asp-items="ViewBag.MiembroId" class="form-select"></select>
                <span asp-validation-for="MiembroId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPrestamo" class="form-label fw-semibold">Fecha de préstamo</label>
                <input asp-for="FechaPrestamo" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaPrestamo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaDevolucion" class="form-label fw-semibold">Fecha de devolución (opcional)</label>
                <input asp-for="FechaDevolucion" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaDevolucion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}