@model EvaluacionParcial1.Models.Prestamo

@{
    ViewData["Title"] = "Registrar Préstamo";
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-journal-arrow-up text-danger me-2"></i>Registrar Préstamo
    </h2>
    <p class="text-muted mb-0">
        Selecciona el libro y el miembro, y define las fechas y el estado del préstamo.
    </p>
</div>
<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="LibroId" class="form-label fw-semibold">Libro</label>
                <select asp-for="LibroId" asp-items="ViewBag.LibroId" class="form-select">
                    <option value="">-- Selecciona un libro --</option>
                </select>
                <span asp-validation-for="LibroId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MiembroId" class="form-label fw-semibold">Miembro</label>
                <select asp-for="MiembroId" asp-items="ViewBag.MiembroId" class="form-select">
                    <option value="">-- Selecciona un miembro --</option>
                </select>
                <span asp-validation-for="MiembroId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPrestamo" class="form-label fw-semibold">Fecha de préstamo</label>
                <input asp-for="FechaPrestamo" class="form-control" type="date" />
                <span asp-validation-for="FechaPrestamo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaDevolucion" class="form-label fw-semibold">Fecha de devolución (opcional)</label>
                <input asp-for="FechaDevolucion" class="form-control" type="date" />
                <span asp-validation-for="FechaDevolucion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-check-lg me-1"></i>Guardar Préstamo
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}