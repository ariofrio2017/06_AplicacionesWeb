<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EvaluacionParcial1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EvaluacionParcial1.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f4f6f9;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar-biblioteca {
            background: linear-gradient(90deg, #1e293b 0%, #0f172a 100%);
        }
        .navbar-biblioteca .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 0.45rem 0.85rem !important;
            border-radius: 0.375rem;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        .navbar-biblioteca .nav-link:hover {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.12);
        }
        .main-card {
            background: #ffffff;
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
            padding: 1.75rem;
            margin-top: 1.5rem;
            margin-bottom: 2rem;
        }
        footer {
            margin-top: auto;
            background-color: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-biblioteca shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half text-info fs-4"></i>
                    <span>Biblioteca MVC</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBiblioteca"
                        aria-controls="navbarBiblioteca" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarBiblioteca">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Libros" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i>Libros
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Autores" asp-action="Index">
                                <i class="bi bi-person-lines-fill me-1"></i>Autores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="LibroAutores" asp-action="Index">
                                <i class="bi bi-link-45deg me-1"></i>Libros y Autores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Miembros" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Miembros
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Prestamos" asp-action="Index">
                                <i class="bi bi-arrow-left-right me-1"></i>Préstamos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="main-card pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>&copy; 2026 - EvaluacionParcial1 · Sistema de Gestión de Biblioteca</span>
            <a class="text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>