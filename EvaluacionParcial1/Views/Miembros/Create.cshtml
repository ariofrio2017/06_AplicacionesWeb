@model EvaluacionParcial1.Models.Miembro

@{
    ViewData["Title"] = "Registrar Miembro";
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-person-plus text-warning me-2"></i>Registrar Miembro
    </h2>
    <p class="text-muted mb-0">
        Completa los datos del miembro para habilitarlo en el sistema de préstamos.
    </p>
</div>
<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Carlos" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apellido" class="form-label fw-semibold">Apellido</label>
                <input asp-for="Apellido" class="form-control" placeholder="Ej. Mendoza" />
                <span asp-validation-for="Apellido" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Correo electrónico</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="Ej. carlos@correo.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaSuscripcion" class="form-label fw-semibold">Fecha de suscripción</label>
                <input asp-for="FechaSuscripcion" class="form-control" type="date" />
                <span asp-validation-for="FechaSuscripcion" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning text-dark fw-semibold">
                    <i class="bi bi-check-lg me-1"></i>Guardar Miembro
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}