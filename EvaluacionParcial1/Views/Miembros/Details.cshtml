@model EvaluacionParcial1.Models.Miembro

@{
    ViewData["Title"] = "Detalles del Miembro";
    var prestamosLista = Model.Prestamos?.OrderByDescending(p => p.FechaPrestamo).ToList()
        ?? new List<EvaluacionParcial1.Models.Prestamo>();
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-eye text-info me-2"></i>Detalles del Miembro
    </h2>
    <p class="text-muted mb-0">
        Información completa del miembro y su historial de préstamos.
    </p>
</div>
<hr />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Nombre</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Nombre</dd>

            <dt class="col-sm-3 text-muted">Apellido</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Apellido</dd>

            <dt class="col-sm-3 text-muted">Correo electrónico</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3 text-muted">Fecha de suscripción</dt>
            <dd class="col-sm-9">@Model.FechaSuscripcion.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 text-muted">Préstamos</dt>
            <dd class="col-sm-9">
                @if (prestamosLista.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var prestamo in prestamosLista)
                        {
                            var tituloLibro = prestamo.Libro?.Titulo ?? $"Libro #{prestamo.LibroId}";
                            var badgeClase = prestamo.Estado == "Activo"
                            ? "bg-primary-subtle text-primary-emphasis border"
                            : "bg-secondary-subtle text-secondary-emphasis border";

                            <div>
                                <span class="badge @badgeClase px-2 py-1">@tituloLibro</span>
                                <span class="text-muted small ms-1">
                                    (@prestamo.Estado · Prestado el @prestamo.FechaPrestamo.ToString("dd/MM/yyyy"))
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted fst-italic">Sin préstamos registrados</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.MiembroId" class="btn btn-warning text-dark">
        <i class="bi bi-pencil me-1"></i>Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista
    </a>
</div>