@model IEnumerable<EvaluacionParcial1.Models.Miembro>

@{
    ViewData["Title"] = "Miembros";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people text-warning me-2"></i>Miembros
        </h2>
        <p class="text-muted mb-0">
            Padrón de miembros registrados y sus préstamos asociados.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-warning text-dark fw-semibold">
        <i class="bi bi-person-plus me-1"></i>Nuevo Miembro
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle border">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo electrónico</th>
                <th class="text-center">Fecha de suscripción</th>
                <th>Préstamos</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-info-circle me-1"></i>No hay miembros registrados todavía.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var prestamosLista = item.Prestamos?.ToList() ?? new List<EvaluacionParcial1.Models.Prestamo>();

                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td class="fw-semibold">@item.Apellido</td>
                        <td>@item.Email</td>
                        <td class="text-center">@item.FechaSuscripcion.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (prestamosLista.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var prestamo in prestamosLista)
                                    {
                                        var tituloLibro = prestamo.Libro?.Titulo ?? $"Libro #{prestamo.LibroId}";
                                        var badgeClase = prestamo.Estado == "Activo"
                                        ? "bg-primary-subtle text-primary-emphasis border"
                                        : "bg-secondary-subtle text-secondary-emphasis border";

                                        <span class="badge @badgeClase px-2 py-1">
                                            @tituloLibro (@prestamo.Estado)
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Sin préstamos</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.MiembroId" class="btn btn-sm btn-outline-warning text-dark">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.MiembroId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#confirmarEliminarMiembroModal"
                                    data-miembro-id="@item.MiembroId"
                                    data-miembro-nombre="@($"{item.Nombre} {item.Apellido}")">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Modal de confirmación Bootstrap -->
<div class="modal fade" id="confirmarEliminarMiembroModal" tabindex="-1" aria-labelledby="confirmarEliminarMiembroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="confirmarEliminarMiembroLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0">
                    ¿Estás seguro de que deseas eliminar al miembro <strong id="miembroNombreModal"></strong>?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </button>
                <form id="formEliminarMiembro" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-lg me-1"></i>Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("confirmarEliminarMiembroModal");
            const formEliminar = document.getElementById("formEliminarMiembro");
            const nombreSpan = document.getElementById("miembroNombreModal");

            modalEl.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                const miembroId = button.getAttribute("data-miembro-id");
                const miembroNombre = button.getAttribute("data-miembro-nombre");

                nombreSpan.textContent = miembroNombre;
                formEliminar.setAttribute("action", `/Miembros/Delete/${miembroId}`);
            });
        });
    </script>
}