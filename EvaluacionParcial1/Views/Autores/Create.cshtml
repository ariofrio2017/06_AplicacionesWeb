@model EvaluacionParcial1.Models.Autor

@{
    ViewData["Title"] = "Registrar Autor";
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-person-plus text-success me-2"></i>Registrar Autor
    </h2>
    <p class="text-muted mb-0">
        Completa los datos del autor para asociarlo luego a los libros del catálogo.
    </p>
</div>
<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Gabriel" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apellido" class="form-label fw-semibold">Apellido</label>
                <input asp-for="Apellido" class="form-control" placeholder="Ej. García Márquez" />
                <span asp-validation-for="Apellido" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nacionalidad" class="form-label fw-semibold">Nacionalidad</label>
                <input asp-for="Nacionalidad" class="form-control" placeholder="Ej. Colombiana" />
                <span asp-validation-for="Nacionalidad" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg me-1"></i>Guardar Autor
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}