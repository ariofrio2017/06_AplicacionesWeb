@model EvaluacionParcial1.Models.Autor

@{
    ViewData["Title"] = "Detalles del Autor";
    var librosEscritos = Model.LibroAutores != null && Model.LibroAutores.Any()
        ? Model.LibroAutores
            .Where(la => la.Libro != null)
            .Select(la => la.Libro!.Titulo)
            .Distinct()
            .ToList()
        : new List<string>();
}

<div class="mb-3">
    <h2 class="fw-bold mb-1">
        <i class="bi bi-eye text-info me-2"></i>Detalles del Autor
    </h2>
    <p class="text-muted mb-0">
        Información completa del autor y las obras asociadas en la biblioteca.
    </p>
</div>
<hr />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Nombre</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Nombre</dd>

            <dt class="col-sm-3 text-muted">Apellido</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Apellido</dd>

            <dt class="col-sm-3 text-muted">Nacionalidad</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Nacionalidad) ? "No especificada" : Model.Nacionalidad)</dd>

            <dt class="col-sm-3 text-muted">Libros escritos</dt>
            <dd class="col-sm-9">
                @if (librosEscritos.Any())
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var titulo in librosEscritos)
                        {
                            <span class="badge bg-info-subtle text-dark border px-2 py-1">@titulo</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted fst-italic">Sin libros escritos</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.AutorId" class="btn btn-warning text-dark">
        <i class="bi bi-pencil me-1"></i>Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista
    </a>
</div>